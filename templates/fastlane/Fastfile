# expo-release — 스토어 앱 정보·스크린샷, Android 업로드.
#
# iOS 빌드 업로드는 여기서 하지 않는다 — scripts/expo-release/ios-build-upload.sh가 한다.
# Android AAB는 scripts/expo-release/android-build.sh가 만들고 여기서 Play에 올린다.
#
#   fastlane ios metadata [screenshots:true] [version:1.0.4] [cancel_review:true]
#   fastlane android upload [aab:build/expo-release/android/app-release.aab] [metadata:true]
#   fastlane android upload metadata:true            AAB 없이 앱 정보·스크린샷만
#
# 키는 환경변수로 받는다.
#   iOS:     ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH(.p8 경로)
#   Android: PLAY_JSON_KEY_PATH(서비스 계정 JSON 경로)
require "json"

CONFIG = JSON.parse(File.read(File.expand_path("../.expo-release.json", __dir__)))

platform :ios do
  lane :metadata do |options|
    api_key
    cancelled = release_guard(options)
    deliver(
      platform: "ios",
      app_identifier: CONFIG.dig("ios", "bundle_id"),
      app_version: options[:version],
      skip_binary_upload: true,
      skip_screenshots: options[:screenshots].to_s != "true",
      overwrite_screenshots: true,
      # 철회했을 때만 원래대로 다시 제출한다. 평소 제출은 사람이 한다.
      submit_for_review: cancelled,
      submission_information: { add_id_info_uses_idfa: false },
      force: true, # CI라 HTML 미리보기 확인을 띄울 사람이 없다
      run_precheck_before_submit: false
    )
  end

  # 심사에 제출된 버전이 있으면 deliver가 스크린샷을 못 지운다
  # ("Can't Delete Screenshot After Submit for review"). deliver 전에 상태를 본다.
  # 철회는 cancel_review:true일 때만 하고, 철회했으면 true를 돌려준다.
  # 심사가 이미 진행 중(IN_REVIEW)이면 철회할 수 없다.
  private_lane :release_guard do |options|
    app = Spaceship::ConnectAPI::App.find(CONFIG.dig("ios", "bundle_id"))
    UI.user_error!("App Store Connect에서 앱을 찾지 못했다") unless app

    submitted = lambda do
      app.get_app_store_versions(filter: { platform: "IOS", appVersionState: "WAITING_FOR_REVIEW,IN_REVIEW" }, limit: 10)
    end
    pending = submitted.call
    next false if pending.empty?

    names = pending.map { |v| "#{v.version_string} (#{v.app_version_state})" }.join(", ")
    if pending.any? { |v| v.app_version_state == "IN_REVIEW" }
      UI.user_error!("#{names} — 심사가 진행 중이라 철회할 수 없다. 심사가 끝난 뒤 다시 실행한다.")
    end
    unless options[:cancel_review].to_s == "true"
      UI.user_error!("#{names} — 심사에 제출돼 있어 앱 정보·스크린샷을 올릴 수 없다. " \
                     "철회하고 올리려면 cancel_review=true로 다시 실행한다(심사 순서를 잃는다).")
    end

    app.get_review_submissions(filter: { platform: "IOS", state: "WAITING_FOR_REVIEW" }).each do |submission|
      UI.important("심사 제출을 철회한다: #{names}")
      submission.cancel_submission
    end
    24.times do
      break if submitted.call.empty?
      sleep(5)
    end
    UI.user_error!("심사 철회가 2분 안에 반영되지 않았다. App Store Connect에서 상태를 확인한다.") unless submitted.call.empty?
    true
  end

  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end
end

platform :android do
  # 앱 정보 경로: fastlane/android/metadata/<언어>/ (title.txt, short_description.txt,
  # full_description.txt, changelogs/<versionCode>.txt, images/phoneScreenshots/)
  lane :upload do |options|
    aab = options[:aab]
    metadata = options[:metadata].to_s == "true"
    UI.user_error!("올릴 AAB도 앱 정보도 없다") if aab.to_s.empty? && !metadata
    supply(
      package_name: CONFIG.dig("android", "package"),
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      track: CONFIG.dig("android", "track") || "internal",
      # completed: 그 트랙에 바로 출시(production이면 검토 제출). draft: Play Console에서 사람이 출시.
      release_status: CONFIG.dig("android", "release_status") || "draft",
      aab: aab.to_s.empty? ? nil : aab,
      skip_upload_aab: aab.to_s.empty?,
      skip_upload_apk: true,
      metadata_path: File.expand_path("android/metadata", __dir__),
      skip_upload_metadata: !metadata,
      skip_upload_images: !metadata,
      skip_upload_screenshots: !metadata,
      # 업데이트 내용(changelogs/<versionCode>.txt)은 새 AAB와 함께만 의미가 있다
      skip_upload_changelogs: aab.to_s.empty?
    )
  end
end
