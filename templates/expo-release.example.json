{
  "branch": "main",
  "app_config": "app.json",
  "env": { "APP_ENV": "prod", "NODE_ENV": "production" },
  "env_files": [".env.production"],
  "ci": {
    "setup": "bash scripts/expo-release/ci-setup.sh",
    "cleanup": "rm -f .env.production GoogleService-Info.prod.plist google-services.prod.json",
    "secrets": ["ENV_PRODUCTION_B64", "GOOGLE_SERVICE_INFO_PROD_B64", "GOOGLE_SERVICES_PROD_JSON_B64"]
  },
  "local_files": [".env.production", "GoogleService-Info.prod.plist", "google-services.prod.json"],
  "auto": {
    "android_track": "internal"
  },
  "ios": {
    "enabled": true,
    "bundle_id": "com.example.app",
    "team_id": "ABCDE12345",
    "runner": "macos-15",
    "xcode": "26",
    "verify": ""
  },
  "android": {
    "enabled": true,
    "package": "com.example.app",
    "track": "production",
    "release_status": "completed",
    "signing_props": {
      "store_file": "UPLOAD_STORE_FILE",
      "store_password": "UPLOAD_STORE_PASSWORD",
      "key_alias": "UPLOAD_KEY_ALIAS",
      "key_password": "UPLOAD_KEY_PASSWORD"
    },
    "verify": ""
  },
  "update": {
    "enabled": true,
    "channel": "production",
    "eas_cli": "eas-cli@latest"
  },
  "screenshots": {
    "scenes": [{ "id": "home", "label": "홈" }],
    "capture": "",
    "compose": "",
    "composer": "codex"
  },
  "eas": {
    "asc_app_id": "1234567890",
    "asc_key_path": "~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8",
    "asc_key_id": "XXXXXXXXXX",
    "asc_issuer_id": "00000000-0000-0000-0000-000000000000",
    "play_json_path": "~/.config/myapp/play-sa.json",
    "android_keystore": "~/path/to/upload.keystore"
  },
  "actions": { "included_minutes": 2000 }
}
